<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:org:panteleyev:mk61"
           targetNamespace="urn:org:panteleyev:mk61"
           elementFormDefault="qualified">

    <xs:simpleType name="Mk61_RegisterNumber">
        <xs:restriction base="xs:int">
            <xs:minInclusive value="0"/>
            <xs:maxInclusive value="14"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Mk61_RegisterValue">
        <xs:restriction base="xs:long">
            <xs:minInclusive value="0"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="Mk61_Register">
        <xs:attribute name="number" type="Mk61_RegisterNumber" use="required">
            <xs:annotation>
                <xs:documentation>
                    Атрибут носит информационный характер и не используется при загрузке.
                    Номер регистра определяется порядковым номером элемента в списке.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="value" type="Mk61_RegisterValue" use="required"/>
    </xs:complexType>

    <xs:complexType name="Mk61_Registers">
        <xs:sequence>
            <xs:element name="register" type="Mk61_Register" minOccurs="15" maxOccurs="15"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="Mk61_MemoryAddress">
        <xs:restriction base="xs:int">
            <xs:minInclusive value="0"/>
            <xs:maxInclusive value="104"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Mk61_OpCode">
        <xs:restriction base="xs:int">
            <xs:minInclusive value="0"/>
            <xs:maxInclusive value="255"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="Mk61_MemoryCell">
        <xs:attribute name="addr" type="Mk61_MemoryAddress" use="required">
            <xs:annotation>
                <xs:documentation>
                    Атрибут носит информационный характер и не используется при загрузке.
                    Позиция в памяти определяется порядковым номером элемента в списке.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="opCode" type="Mk61_OpCode" use="required"/>
        <xs:attribute name="opCodeHex" type="xs:string"/>
        <xs:attribute name="mnemonics" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="Mk61_Memory">
        <xs:sequence>
            <xs:element name="cell" type="Mk61_MemoryCell" minOccurs="105" maxOccurs="105"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Mk61_Program">
        <xs:sequence>
            <xs:element name="title" type="xs:string"/>
            <xs:element name="author" type="xs:string" minOccurs="0"/>
            <xs:element name="source" type="xs:string" minOccurs="0"/>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="registers" type="Mk61_Registers"/>
            <xs:element name="memory" type="Mk61_Memory"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>